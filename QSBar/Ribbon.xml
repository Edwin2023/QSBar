<customUI xmlns='http://schemas.microsoft.com/office/2009/07/customui' onLoad='OnLoad'>
  <ribbon>
    <tabs>
      <tab id='tabQSBar' getLabel='GetRibbonLabel'>
        <group id='groupFormat' getLabel='GetRibbonLabel'>
          <button id='btnBatch' getLabel='GetRibbonLabel' onAction='OnBatchProcess' imageMso='ViewSheetGridlines'
            size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnNormalize' getLabel='GetRibbonLabel' onAction='OnNormalizeNumbers'
            imageMso='NumberFormat' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnTextify' getLabel='GetRibbonLabel' onAction='OnTextify' imageMso='TextBoxInsert'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnLock' getLabel='GetRibbonLabel' onAction='OnLockFormula' imageMso='Lock' size='normal'
            getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>

        <group id='groupBQ' getLabel='GetRibbonLabel'>
          <button id='btnSetGrading' getLabel='GetRibbonLabel' onAction='OnSetGrading' imageMso='ObjectsGroup'
            size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnSetGradingStyle' getLabel='GetRibbonLabel' onAction='OnSetGradingStyle'
            imageMso='FormatPainter' size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnOutSheet' getLabel='GetRibbonLabel' onAction='OnExportCurrentSheet'
            imageMso='WindowNew' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnOutStd' getLabel='GetRibbonLabel' onAction='OnExportStandardReport'
            imageMso='FileSaveAs' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnOutInt' getLabel='GetRibbonLabel' onAction='OnExportInternalReport'
            imageMso='FileSaveAs' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>

        <group id='groupGrading' getLabel='GetRibbonLabel'>
          <button id='btnMergeSheets' getLabel='GetRibbonLabel' onAction='OnMergeSheets' imageMso='Consolidate'
            size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnSheetIndex' getLabel='GetRibbonLabel' onAction='OnCreateSheetIndex'
            imageMso='Numbering' size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnFileDir' getLabel='GetRibbonLabel' onAction='OnCreateFileIndex' imageMso='FileOpen'
            size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>

        <group id='groupPhotoTools' getLabel='GetRibbonLabel'>
          <button id='btnSelVisible' getLabel='GetRibbonLabel' onAction='OnSelectVisibleCells'
            imageMso='SelectAll' size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnSelectAllPictures' getLabel='GetRibbonLabel' onAction='OnSelectAllPictures'
            imageMso='SelectAll' size='large' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnResize1' getLabel='GetRibbonLabel' onAction='OnResizePictures' tag='1'
            imageMso='PictureInsertFromFile' size='normal' />
          <button id='btnResize2' getLabel='GetRibbonLabel' onAction='OnResizePictures' tag='2'
            imageMso='PictureInsertFromFile' size='normal' />
          <button id='btnResize4' getLabel='GetRibbonLabel' onAction='OnResizePictures' tag='4'
            imageMso='PictureInsertFromFile' size='normal' />
        </group>

        <group id='groupSheets' getLabel='GetRibbonLabel'>
          <button id='btnForceRefresh' getLabel='GetRibbonLabel' onAction='OnForceRefresh' imageMso='Refresh'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnValOnly' getLabel='GetRibbonLabel' onAction='OnConvertAllToValues'
            imageMso='PasteValues' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnUnhideSheets' getLabel='GetRibbonLabel' onAction='OnUnhideAllSheets'
            imageMso='FillRight' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnBreakLinks' getLabel='GetRibbonLabel' onAction='OnBreakLinks' imageMso='EditLinks'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnPurgeNames' getLabel='GetRibbonLabel' onAction='OnPurgeNames' imageMso='NameDefine'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnDeleteEmptyRows' getLabel='GetRibbonLabel' onAction='OnDeleteEmptyRows'
            imageMso='TableRowsDelete' size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>

        <group id='groupCalc' getLabel='GetRibbonLabel'>
          <button id='btnCalcAuto' getLabel='GetRibbonLabel' keytip='F10' getVisible='GetCalcAutoVisible'
            onAction='OnToggleCalculation' imageMso='CalculateNow' size='large'
            getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnCalcManual' getLabel='GetRibbonLabel' keytip='F10' getVisible='GetCalcManualVisible'
            onAction='OnToggleCalculation' imageMso='CalculateFull' size='large'
            getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>

        <group id='groupHelpUpdate' getLabel='GetRibbonLabel'>
          <button id='btnHelp' getLabel='GetRibbonLabel' onAction='OnShowHelp' imageMso='Help' size='large'
            getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnCheckUpdate' getLabel='GetRibbonLabel' onAction='OnCheckUpdate' imageMso='Refresh'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnToggleLanguage' getLabel='GetRibbonLabel' onAction='OnToggleLanguage' imageMso='ReviewTranslate'
            size='normal' getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
          <button id='btnUpdate' getLabel='GetRibbonLabel' getVisible='GetHelpUpdateVisible'
            onAction='OnRestartUpdate' imageMso='Refresh' size='normal'
            getScreentip='GetRibbonScreentip' getSupertip='GetRibbonSupertip' />
        </group>
      </tab>
    </tabs>
  </ribbon>
</customUI>
