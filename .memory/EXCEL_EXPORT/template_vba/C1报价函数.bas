'????¹×??? "1000mm?? ?? 2400mm???????????" ????? 1000*2400
Function ExtExp(txt As String) As String
    Dim regEx As Object
    Dim matches As Object
    Dim m As Object
    
    Set regEx = CreateObject("VBScript.RegExp")
    
    With regEx
        ' ????????????
        ' ???? + ?????¦Ë + ??????????/??/??/?????
        ' + ???
        ' + ???? + ?????¦Ë + ???????
        .Pattern = "(\d+(\.\d+)?)[ ]*(mm|cm|m)?[ ]*(??|??|??|??)?[ ]*[*x??][ ]*(\d+(\.\d+)?)[ ]*(mm|cm|m)?[ ]*(??|??|??|??)?"
        .IgnoreCase = True
        .Global = False
    End With
    
    If regEx.Test(txt) Then
        Set matches = regEx.Execute(txt)
        Set m = matches(0)
        
        ' m.SubMatches:
        ' 0 = ?????????
        ' 4 = ???????????????????
        ExtExp = m.SubMatches(0) & "*" & m.SubMatches(4)
    Else
        ExtExp = ""
    End If
End Function



'???????
Function ExtNum(rng As Range) As String
    Dim s As String, i As Integer, ch As String
    s = rng.Value
    For i = 1 To Len(s)
        ch = Mid(s, i, 1)
        If ch >= "0" And ch <= "9" Or ch = "," Then
            ExtNum = ExtNum & ch
        End If
    Next i
End Function

' ???????? JS??????Excel??????????§Ö???????????????
Public Function JS(C) As Double

    ' ???????????????????????????§Õ???
    On Error Resume Next

    ' ?????????????????
    For k = 1 To C.Count
        ' ?????????????
        Debug.Print C.item(k)
        P = C.item(k)

        ' ?????????????????????????0????????
        If P = "" Then
            JS = ""
            Exit For
        Else
            ' ?I???????????????????
            ' A???????????????????
            ' B?????????????????????
            a = Array("??", "??", "??", "??", "??", "??", "??", "??", "??", "??", Chr(10), " ")
            B = Array("[", "]", "+", "-", "*", "/", "(", ")", ",", ".", "", "")

            ' ?????????I????????
            For n = 0 To UBound(a)
                P = Replace(P, a(n), B(n))
            Next n

            ' ????????????¦¶????????
            For i = 1 To Len(P) - Len(Replace(P, "[", ""))
                P = Left$(P, InStr(P, "[") - 1) & Right$(P, Len(P) - InStr(P, "]"))
            Next i

            ' ???????????????????????????? JS
            JS = JS + Application.Evaluate(P)
        End If
    Next k

    ' ?????????
     Application.Volatile ??????????????????????§Ý????£
    ' Application.Volatile '???????????????????????????
End Function



Function FORMULAR(rng As Range)

     Application.Volatile ??????????????????????§Ý????£
    ' Application.Volatile '???????????????????????????
    
    F = Application.Evaluate(WorksheetFunction.Substitute(WorksheetFunction.Substitute(rng, "[", "*ISTEXT(""["), "]", "]"")"))

    If IsError(F) Then
        FORMULAR = ""
    Else
        FORMULAR = F
    End If
    ' ?????????


End Function
